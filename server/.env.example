# Copy to .env on the server. Never commit the real .env.
PORT=5091
# Password for the results dashboard at /admin
ADMIN_PASSWORD=change-me
# Random secret used to sign dashboard session tokens
TOKEN_SECRET=change-me-to-a-long-random-string
# Where the SQLite database lives (directory is created if missing)
DB_PATH=./data/ibbplus.db
# Confirmation emails via Resend. The sender's domain must be verified in Resend.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=IBB+ Impact Business Awards <invite@ibbplus.com>
# Where replies to the confirmation email go
EMAIL_REPLY_TO=ibb@impactadvisory.co.tz
